# vm/config.env — Edit these paths for your host before running launch.sh

# Path to the Windows disk image (qcow2)
DISK_IMAGE="/var/lib/libvirt/images/win11-stealth.qcow2"

# Path to the Windows installation ISO
WIN_ISO="/var/lib/libvirt/isos/Win11_23H2_English_x64.iso"

# Path to virtio-win ISO (patched drivers — see scripts/driver-rename.py)
VIRTIO_ISO="/var/lib/libvirt/isos/virtio-win-patched.iso"

# OVMF firmware paths (Ubuntu: apt install ovmf)
OVMF_CODE="/usr/share/OVMF/OVMF_CODE.fd"
OVMF_VARS_TEMPLATE="/usr/share/OVMF/OVMF_VARS.fd"
OVMF_VARS="/var/lib/libvirt/qemu/nvram/win11-stealth_VARS.fd"

# VM resources
VM_RAM="8G"
VM_CORES="4"          # Must match -smp setting in launch.sh
VM_SOCKETS="1"
VM_CORES_PER_SOCKET="2"
VM_THREADS="2"

# Network
TAP_IFACE="tap0"
MAC_ADDR="00:14:22:AB:CD:EF"   # Dell OUI; change last 3 octets for uniqueness

# ACPI override (set to 0 to disable if troubleshooting boot issues)
STEALTH_ACPI=1

# Paths
ACPI_AML="$(dirname "$0")/acpi/SSDT-fake-battery.aml"
MONITOR_SOCK="/tmp/qemu-stealth-monitor.sock"
PID_FILE="/var/run/qemu-stealth.pid"
